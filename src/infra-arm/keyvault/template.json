{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": { "description": "Environment name (dev/prod)" }
    },
    "suffix": {
      "type": "string",
      "metadata": { "description": "Unique suffix shared across all resources in this deployment" }
    }
  },
  "variables": {
    "envShort": "[if(equals(toLower(parameters('environmentName')), 'prod'), 'p', 'd')]",
    "sfx": "[toLower(parameters('suffix'))]",
    "keyVaultName": "[toLower(take(concat('rgkv', variables('envShort'), 'v1', variables('sfx')), 24))]"
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[resourceGroup().location]",
      "tags": {
        "environment": "[parameters('environmentName')]",
        "managedBy": "github-actions"
      },
      "properties": {
        "sku": { "family": "A", "name": "standard" },
        "tenantId": "[subscription().tenantId]",
        "enabledForTemplateDeployment": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "enableRbacAuthorization": false,
        "accessPolicies": []
      }
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))).vaultUri]"
    }
  }
}
