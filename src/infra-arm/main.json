{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Prefix name used for all deployed resources"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "brazilsouth",
      "metadata": {
        "description": "Azure region for all resources (brazilsouth recommended for data sovereignty)"
      }
    },
    "functionAppRuntime": {
      "type": "string",
      "defaultValue": "node",
      "allowedValues": [
        "node",
        "python"
      ],
      "metadata": {
        "description": "Runtime stack for Azure Functions (Node.js or Python per team expertise)"
      }
    },
    "cosmosDBFreeTier": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable Cosmos DB free tier discount (1 per subscription)"
      }
    },
    "skuAPIM": {
      "type": "string",
      "defaultValue": "Developer",
      "allowedValues": [
        "Developer",
        "Basic",
        "Standard"
      ],
      "metadata": {
        "description": "API Management SKU (Developer tier for pilot)"
      }
    }
  },
  "variables": {
    "nameMaxLength": 24,
    "storageAccountName": "[toLower(concat('az', substring(replace(parameters('environmentName'), '-', ''), 0, min(length(replace(parameters('environmentName'), '-', '')), 5)), uniqueString(resourceGroup().id)))]",
    "functionAppName": "[concat('az-rapidgo-', parameters('environmentName'), '-functions')]",
    "functionPlanName": "[concat('az-rapidgo-', parameters('environmentName'), '-plan')]",
    "apimName": "[concat('az-rapidgo-', parameters('environmentName'), '-apim')]",
    "cosmosAccountName": "[toLower(concat('azrapidgo', parameters('environmentName'), 'db', uniqueString(resourceGroup().id)))]",
    "cosmosDatabaseName": "[concat('az-rapidgo-', parameters('environmentName'), '-db')]",
    "cosmosContainerName": "pedidos",
    "blobStorageAccountName": "[toLower(concat('az', substring(replace(parameters('environmentName'), '-', ''), 0, min(length(replace(parameters('environmentName'), '-', '')), 4)), 'blob', uniqueString(resourceGroup().id)))]",
    "blobContainerName": "entregas",
    "notificationHubNamespace": "[concat('az-rapidgo-', parameters('environmentName'), '-notif-ns')]",
    "notificationHubName": "[concat('az-rapidgo-', parameters('environmentName'), '-notifications')]",
    "keyVaultName": "[toLower(take(concat('az-', parameters('environmentName'), '-kv-', substring(uniqueString(resourceGroup().id), 0, 4)), 24))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deployBlobStorage",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "blob-storage/deploy.json",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "storageAccountName": {
            "value": "[variables('blobStorageAccountName')]"
          },
          "containerName": {
            "value": "[variables('blobContainerName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deployCosmosDB",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "cosmos-db/deploy.json",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "accountName": {
            "value": "[variables('cosmosAccountName')]"
          },
          "databaseName": {
            "value": "[variables('cosmosDatabaseName')]"
          },
          "containerName": {
            "value": "[variables('cosmosContainerName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "enableFreeTier": {
            "value": "[parameters('cosmosDBFreeTier')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deployNotificationHubs",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "notification-hubs/deploy.json",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "namespaceName": {
            "value": "[variables('notificationHubNamespace')]"
          },
          "hubName": {
            "value": "[variables('notificationHubName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deployKeyVault",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "key-vault/deploy.json",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "keyVaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deployKeyVaultSecrets",
      "dependsOn": [
        "deployKeyVault",
        "deployCosmosDB",
        "deployBlobStorage",
        "deployNotificationHubs"
      ],
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "keyVaultName": {
              "type": "string"
            },
            "cosmosDbConnectionString": {
              "type": "string"
            },
            "blobStorageConnectionString": {
              "type": "string"
            },
            "notificationHubConnectionString": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults/secrets",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}/cosmos-db-connection-string', parameters('keyVaultName'))]",
              "properties": {
                "value": "[parameters('cosmosDbConnectionString')]"
              }
            },
            {
              "type": "Microsoft.KeyVault/vaults/secrets",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}/blob-storage-connection-string', parameters('keyVaultName'))]",
              "properties": {
                "value": "[parameters('blobStorageConnectionString')]"
              }
            },
            {
              "type": "Microsoft.KeyVault/vaults/secrets",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}/notification-hub-connection-string', parameters('keyVaultName'))]",
              "properties": {
                "value": "[parameters('notificationHubConnectionString')]"
              }
            }
          ]
        },
        "parameters": {
          "keyVaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "cosmosDbConnectionString": {
            "value": "[reference('deployCosmosDB').outputs.connectionString.value]"
          },
          "blobStorageConnectionString": {
            "value": "[reference('deployBlobStorage').outputs.connectionString.value]"
          },
          "notificationHubConnectionString": {
            "value": "[reference('deployNotificationHubs').outputs.connectionString.value]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deployFunctionApp",
      "dependsOn": [
        "deployKeyVault",
        "deployBlobStorage",
        "deployCosmosDB",
        "deployNotificationHubs"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "function-app/deploy.json",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "functionAppName": {
            "value": "[variables('functionAppName')]"
          },
          "planName": {
            "value": "[variables('functionPlanName')]"
          },
          "storageAccountName": {
            "value": "[variables('storageAccountName')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "runtime": {
            "value": "[parameters('functionAppRuntime')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "keyVaultUri": {
            "value": "[reference('deployKeyVault').outputs.keyVaultUri.value]"
          },
          "cosmosDatabaseName": {
            "value": "[variables('cosmosDatabaseName')]"
          },
          "cosmosContainerName": {
            "value": "[variables('cosmosContainerName')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "updateKeyVaultAccessPolicy",
      "dependsOn": [
        "deployFunctionApp",
        "deployKeyVault"
      ],
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "keyVaultName": {
              "type": "string"
            },
            "principalId": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults/accessPolicies",
              "apiVersion": "2023-07-01",
              "name": "[format('{0}/add', parameters('keyVaultName'))]",
              "properties": {
                "accessPolicies": [
                  {
                    "tenantId": "[subscription().tenantId]",
                    "objectId": "[parameters('principalId')]",
                    "permissions": {
                      "secrets": [
                        "get",
                        "list"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        "parameters": {
          "keyVaultName": {
            "value": "[variables('keyVaultName')]"
          },
          "principalId": {
            "value": "[reference('deployFunctionApp').outputs.principalId.value]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "deployAPIM",
      "dependsOn": [
        "deployFunctionApp"
      ],
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "api-management/deploy.json",
          "contentVersion": "1.0.0.0"
        },
        "parameters": {
          "apimName": {
            "value": "[variables('apimName')]"
          },
          "publisherName": {
            "value": "RapidGo Team"
          },
          "publisherEmail": {
            "value": "team@rapidgo.app"
          },
          "sku": {
            "value": "[parameters('skuAPIM')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "functionAppUrl": {
            "value": "[reference('deployFunctionApp').outputs.functionAppDefaultHostName.value]"
          }
        }
      }
    }
  ],
  "outputs": {
    "functionAppDefaultHostName": {
      "type": "string",
      "value": "[reference('deployFunctionApp').outputs.functionAppDefaultHostName.value]"
    },
    "apimGatewayUrl": {
      "type": "string",
      "value": "[reference('deployAPIM').outputs.gatewayUrl.value]"
    },
    "cosmosDbEndpoint": {
      "type": "string",
      "value": "[reference('deployCosmosDB').outputs.endpoint.value]"
    },
    "blobStorageEndpoint": {
      "type": "string",
      "value": "[reference('deployBlobStorage').outputs.endpoint.value]"
    },
    "notificationHubEndpoint": {
      "type": "string",
      "value": "[reference('deployNotificationHubs').outputs.endpoint.value]"
    },
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    }
  }
}
