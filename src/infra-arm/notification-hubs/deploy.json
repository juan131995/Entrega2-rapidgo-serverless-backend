{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namespaceName": { "type": "string" },
    "hubName": { "type": "string" },
    "location": { "type": "string" },
    "fcmApiKey": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Firebase Cloud Messaging server key for Android push notifications"
      }
    },
    "environmentName": { "type": "string" }
  },
  "variables": {
    "nhVersion": "2023-01-01-preview"
  },
  "resources": [
    {
      "type": "Microsoft.NotificationHubs/namespaces",
      "apiVersion": "[variables('nhVersion')]",
      "name": "[parameters('namespaceName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Free" },
      "tags": {
        "environment": "[parameters('environmentName')]",
        "managedBy": "arm-template"
      },
      "properties": {
        "zoneRedundancy": "Disabled"
      }
    },
    {
      "type": "Microsoft.NotificationHubs/namespaces/notificationHubs",
      "apiVersion": "[variables('nhVersion')]",
      "name": "[format('{0}/{1}', parameters('namespaceName'), parameters('hubName'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.NotificationHubs/namespaces', parameters('namespaceName'))]"
      ],
      "tags": {
        "environment": "[parameters('environmentName')]",
        "managedBy": "arm-template"
      },
      "properties": {
        "apnsCredential": null,
        "wnsCredential": null
      }
    },
    {
      "condition": "[not(empty(parameters('fcmApiKey')))]",
      "type": "Microsoft.NotificationHubs/namespaces/notificationHubs/authorizationRules",
      "apiVersion": "[variables('nhVersion')]",
      "name": "[format('{0}/{1}/{2}', parameters('namespaceName'), parameters('hubName'), 'DefaultFullSharedAccessSignature')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.NotificationHubs/namespaces/notificationHubs', parameters('namespaceName'), parameters('hubName'))]"
      ],
      "properties": {
        "rights": ["Listen", "Send", "Manage"]
      }
    }
  ],
  "outputs": {
    "endpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.NotificationHubs/namespaces', parameters('namespaceName'))).serviceBusEndpoint]"
    },
    "connectionString": {
      "type": "string",
      "value": "[listKeys(resourceId('Microsoft.NotificationHubs/namespaces/notificationHubs/authorizationRules', parameters('namespaceName'), parameters('hubName'), 'DefaultFullSharedAccessSignature'), variables('nhVersion')).primaryConnectionString]"
    },
    "namespaceName": {
      "type": "string",
      "value": "[parameters('namespaceName')]"
    },
    "hubName": {
      "type": "string",
      "value": "[parameters('hubName')]"
    }
  }
}
