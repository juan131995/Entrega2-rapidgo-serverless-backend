{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "keyVaultName": { "type": "string" },
    "location": { "type": "string" },
    "environmentName": { "type": "string" },
    "functionAppPrincipalId": { "type": "string", "defaultValue": "" }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "tags": {
        "environment": "[parameters('environmentName')]",
        "managedBy": "arm-template"
      },
      "properties": {
        "sku": { "family": "A", "name": "standard" },
        "tenantId": "[subscription().tenantId]",
        "enabledForTemplateDeployment": true,
        "enableRbacAuthorization": false,
        "accessPolicies": [
          {
            "tenantId": "[subscription().tenantId]",
            "objectId": "[parameters('functionAppPrincipalId')]",
            "permissions": {
              "secrets": ["get", "list"]
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "keyVaultName": { "type": "string", "value": "[parameters('keyVaultName')]" },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))).vaultUri]"
    }
  }
}
